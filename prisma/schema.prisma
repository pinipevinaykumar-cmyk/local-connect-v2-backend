generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model State {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
  users     User[]
}

model District {
  id      Int      @id @default(autoincrement())
  name    String
  state   State    @relation(fields: [stateId], references: [id])
  stateId Int
  mandals Mandal[]
  users   User[]
  shops   Shop[]

  @@unique([stateId, name])
}

model Mandal {
  id         Int       @id @default(autoincrement())
  name       String
  district   District  @relation(fields: [districtId], references: [id])
  districtId Int
  villages   Village[]
  users      User[]
  shops      Shop[]

  @@unique([districtId, name])
}

model Village {
  id       Int    @id @default(autoincrement())
  name     String
  mandal   Mandal @relation(fields: [mandalId], references: [id])
  mandalId Int
  users    User[]
  shops    Shop[]

  @@unique([mandalId, name])
}

enum UserType {
  USER
  ADMIN
}

model User {
  id           Int       @id @default(autoincrement())
  userType     UserType  @default(USER)
  username     String    @unique
  phone        String    @unique
  passwordHash String
  stateId      Int?
  districtId   Int?
  mandalId     Int?
  villageId    Int?
  state        State?    @relation(fields: [stateId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
  mandal       Mandal?   @relation(fields: [mandalId], references: [id])
  village      Village?  @relation(fields: [villageId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shops        Shop[]
  roleId       Int?
  role         Role?     @relation(fields: [roleId], references: [id])
}

enum ModuleStatus {
  ENABLED
  DISABLED
  MAINTENANCE
}

model SystemModule {
  id           Int          @id @default(autoincrement())
  moduleName   String       @unique
  parentModule String?
  status       ModuleStatus @default(ENABLED)
  displayOrder Int          @default(0)
  updatedBy    Int?
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())
}

enum ShopStatus {
  OPEN
  CLOSED
  BUSY
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CHANGES_REQUESTED
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  icon  String @default("🏪")
  shops Shop[]
}

model Shop {
  id          Int        @id @default(autoincrement())
  name        String
  ownerName   String?
  description String?
  phone       String?
  whatsapp    String?
  address     String?
  status      ShopStatus @default(CLOSED)
  openTime    String?    @default("08:00")
  closeTime   String?    @default("21:00")
  is24Hours   Boolean    @default(false)
  hasDelivery Boolean    @default(false)
  imageUrl    String?
  coverUrl    String?
  ownerId     Int?
  categoryId  Int?
  districtId  Int?
  mandalId    Int?
  villageId   Int?
  owner       User?      @relation(fields: [ownerId], references: [id])
  category    Category?  @relation(fields: [categoryId], references: [id])
  district    District?  @relation(fields: [districtId], references: [id])
  mandal      Mandal?    @relation(fields: [mandalId], references: [id])
  village     Village?   @relation(fields: [villageId], references: [id])
  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  verificationNote   String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ───────────────────────── Admin panel core ─────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  menuRoles   MenuRole[]
  users       User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Menu {
  id        Int        @id @default(autoincrement())
  label     String
  slug      String     @unique
  icon      String     @default("circle")
  url       String
  section   String     @default("main")
  order     Int        @default(0)
  isEnabled Boolean    @default(true)
  moduleKey String?
  parentId  Int?
  parent    Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]     @relation("MenuTree")
  roles     MenuRole[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A menu with no MenuRole rows is visible to everyone.
model MenuRole {
  menuId Int
  roleId Int
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuId, roleId])
}

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  updatedBy   Int?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String?
  action    String
  module    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
  @@index([actorId])
}

model Setting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedBy Int?
  updatedAt DateTime @updatedAt
}
